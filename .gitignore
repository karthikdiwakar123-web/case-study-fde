# Local environment files; keep the safe template available for setup.
**/.env
**/.env.*
!**/.env.example
**/.envrc

# Python environments and generated bytecode.
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]

# Node dependencies and generated frontend output.
**/node_modules/
**/.angular/
**/dist/
**/coverage/
npm-debug.log*

# Editor and operating-system files.
**/.vscode/
.idea/
.DS_Store
Thumbs.db

# Local database files and logs.
*.db
*.sqlite
*.sqlite3
*.mdf
*.ldf
*.log

# Local-only notes, scratch utilities, and unused duplicate seed data.
/instructions.txt
/backend/test_db.py
/seed_scripts/package.json
